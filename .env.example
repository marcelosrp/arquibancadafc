# Copie para .env e preencha. Nunca versione valores reais.

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/arquibancada

# API-Football (somente servidor; nunca use NEXT_PUBLIC_)
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=

# Auth.js — gere com: npx auth secret
AUTH_SECRET=

# Segredo da rota de cron (/api/internal/refresh)
CRON_SECRET=

# Opcional: força a temporada (plano gratuito cobre 2022–2024). Em dev: 2024
SEASON_OVERRIDE=2024

# Opcional: envio de e-mail (sem ela, o link de reset é logado no console)
RESEND_API_KEY=
