# Credenciais locais do docker-compose.yml (banco de teste). Sem segredos reais.
DATABASE_URL=postgresql://arquibancada:arquibancada@localhost:5433/arquibancada_test

# E2E (Playwright): app aponta para o servidor mock local, nunca para a API real.
API_FOOTBALL_BASE_URL=http://localhost:4010
API_FOOTBALL_KEY=test-key-not-real
AUTH_SECRET=e2e-auth-secret-not-for-production
CRON_SECRET=e2e-cron-secret
SEASON_OVERRIDE=2024
